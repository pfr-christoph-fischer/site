---
permalink: /predigten/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>{{ site.title }} – Predigten</title>
    <link>{{ site.url }}/predigten/</link>
    <description>Predigtfeed von {{ site.title }}</description>
    {% for sermon in collections.sermons.slice(0, 20) %}
    <item>
      <title>{{ sermon.data.title | escape }}</title>
      <link>{{ sermon.url | absoluteUrl(site) }}</link>
      <guid>{{ sermon.url | absoluteUrl(site) }}</guid>
      <pubDate>{{ sermon.date.toUTCString() }}</pubDate>
      <description>{{ (sermon.data.summary or sermon.templateContent | excerpt(240)) | escape }}</description>
      {% if sermon.data.audio %}
      <enclosure url="{{ (sermon.url + sermon.data.audio) | absoluteUrl(site) }}" type="audio/mpeg"/>
      {% endif %}
    </item>
    {% endfor %}
  </channel>
</rss>
