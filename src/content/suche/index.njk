---
layout: layouts/page.njk
title: Suche
summary: Volltextsuche über die statischen Inhalte mit Pagefind.
permalink: /suche/
index: false
---
<div class="search-shell">
  <p class="search-note">Die Suche arbeitet vollständig statisch. Wenn JavaScript deaktiviert ist, bleiben die regulären Archive und Übersichtsseiten nutzbar.</p>
  <div id="search-results"></div>
</div>
<script src="/pagefind/pagefind-ui.js"></script>
<script>
  window.addEventListener("DOMContentLoaded", function () {
    const params = new URLSearchParams(window.location.search);
    const initialQuery = (params.get("q") || "").trim();

    new PagefindUI({
      element: "#search-results",
      showSubResults: true,
      resetStyles: false,
      translations: {
        placeholder: "Website durchsuchen",
        clear_search: "Suche löschen",
        load_more: "Mehr Ergebnisse",
        search_label: "Suche",
        filters_label: "Filter",
        zero_results: "Keine Treffer für [SEARCH_TERM]",
        many_results: "[COUNT] Treffer für [SEARCH_TERM]",
        one_result: "[COUNT] Treffer für [SEARCH_TERM]",
        alt_search: "Keine Treffer für [SEARCH_TERM]. Ergebnisse für [DIFFERENT_TERM] anzeigen?",
        search_suggestion: "Keine Treffer für [SEARCH_TERM]. Vorschlag: [DIFFERENT_TERM].",
        searching: "Suche läuft für [SEARCH_TERM]"
      }
    });

    const syncUrl = (value) => {
      const nextUrl = new URL(window.location.href);
      if (value) {
        nextUrl.searchParams.set("q", value);
      } else {
        nextUrl.searchParams.delete("q");
      }
      window.history.replaceState({}, "", nextUrl);
    };

    const connectSearchInput = () => {
      const input = document.querySelector(".pagefind-ui__search-input");
      if (!input) {
        window.requestAnimationFrame(connectSearchInput);
        return;
      }

      if (initialQuery) {
        input.value = initialQuery;
        input.dispatchEvent(new Event("input", { bubbles: true }));
      }

      input.addEventListener("input", () => {
        syncUrl(input.value.trim());
      });
    };

    connectSearchInput();
  });
</script>
