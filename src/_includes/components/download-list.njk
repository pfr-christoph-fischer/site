{% if downloads and downloads.length %}
  <section class="download-block">
    <h2>Downloads</h2>
    <ul class="download-list">
      {% for download in downloads %}
        <li>
          <a href="{{ download.file }}">{{ download.title }}</a>
          {% if download.type or download.size %}
            <span class="meta">
              {% if download.type %}{{ download.type }}{% endif %}{% if download.type and download.size %} · {% endif %}{% if download.size %}{{ download.size }}{% endif %}
            </span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}
