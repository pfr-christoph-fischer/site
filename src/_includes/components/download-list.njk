{% if downloads and downloads.length %}
  <section class="download-block">
    <h2>Downloads</h2>
    <ul class="download-list">
      {% for download in downloads %}
        {% set meta = download | downloadMeta(page) %}
        <li>
          <a href="{{ download.file }}">{{ download.title }}</a>
          {% if meta.type or meta.size %}
            <span class="meta">
              {% if meta.type %}{{ meta.type }}{% endif %}{% if meta.type and meta.size %} · {% endif %}{% if meta.size %}{{ meta.size }}{% endif %}
            </span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}
