{% if archiveItems and archiveItems.length %}
  {% set resolvedHeadingLevel = archiveHeadingLevel or "h2" %}
  <div class="archive-list{% if archiveClass %} {{ archiveClass }}{% endif %}">
    {% for item in archiveItems %}
      {% set entry = item.data %}
      {% if entry.cover %}
        {% set entryCoverUrl = entry.cover | imageUrl(item) %}
      {% endif %}
      <article class="archive-entry{% if entry.cover %} archive-entry--with-image{% endif %}">
        {% if entry.cover %}
          <a class="archive-entry__media" href="{{ item.url }}" aria-label="{{ entry.title }}">
            <img
              src="{{ entryCoverUrl }}"
              alt="{{ entry.cover_alt or ('Titelbild zu ' + entry.title) }}"
              class="archive-entry__image"
              loading="lazy"
              decoding="async"
            >
          </a>
        {% endif %}
        <div class="archive-entry__body">
          <div class="archive-entry__meta meta">
            {% if entry.date %}
              <time datetime="{{ entry.date | htmlDateString }}">{{ entry.date | readableDate("dd.MM.yyyy") }}</time>
            {% endif %}
            {% if entry.occasion %} · {{ entry.occasion }}{% endif %}
            {% if entry.scripture %} · {{ entry.scripture }}{% endif %}
          </div>
          <{{ resolvedHeadingLevel }}><a href="{{ item.url }}">{{ entry.title }}</a></{{ resolvedHeadingLevel }}>
          {% if entry.summary %}
            <p>{{ entry.summary }}</p>
          {% endif %}
          {% if entry.tagList and entry.tagList.length %}
            {% set tags = entry.tagList %}
            {% include "components/tag-links.njk" %}
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
{% endif %}
