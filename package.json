{
  "name": "christoph-fischer-2026",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean-site-output.mjs",
    "dev": "npx @11ty/eleventy --serve",
    "generate:assets": "node scripts/generate-site-assets.mjs",
    "fix:sermon-audio-durations": "node scripts/fix-sermon-audio-durations.mjs",
    "validate": "node scripts/validate-content.mjs",
    "audit:a11y": "node scripts/audit-accessibility.mjs",
    "audit:a11y:full": "node scripts/audit-accessibility.mjs --full",
    "build": "npm run generate:assets && npm run fix:sermon-audio-durations && npm run validate && npx @11ty/eleventy && node scripts/copy-sermon-assets.mjs && npm run search && node scripts/validate-content.mjs --site",
    "build:clean": "npm run clean && npm run build",
    "search": "npx pagefind --site _site",
    "backend": "node backend/server.mjs",
    "federate": "node scripts/federate-new-posts.mjs",
    "activitypub:block": "node scripts/activitypub-block-actor.mjs",
    "activitypub:unblock": "node scripts/activitypub-unblock-actor.mjs",
    "activitypub:remove-follower": "node scripts/activitypub-remove-follower.mjs",
    "activitypub:retry-deliveries": "node scripts/activitypub-retry-deliveries.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:backend": "node scripts/deploy-backend.mjs",
    "publish": "npm run build:clean && npm run deploy && npm run federate",
    "import:latest-sermon": "node scripts/import-latest-sermon.mjs",
    "release:sermon": "node scripts/release-sermon.mjs",
    "commit:sermons-submodule": "node scripts/commit-sermons-submodule.mjs",
    "import:open-source": "node scripts/import-open-source-repos.mjs",
    "sync:sermon-metadata": "node scripts/sync-sermon-metadata.mjs",
    "migrate:sermons": "node scripts/migrate-sermons.mjs",
    "rewrite:sermons-markdown": "node scripts/rewrite-sermons-markdown.mjs",
    "fix:sermon-cover-extensions": "node scripts/fix-sermon-cover-extensions.mjs",
    "fix:sermon-bible-version-tags": "node scripts/strip-sermon-bible-version-tags.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.0",
    "@11ty/eleventy-img": "^6.0.0",
    "luxon": "^3.7.1"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.3",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.2.5",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.2.6",
    "pa11y-ci": "^4.1.1",
    "pagefind": "^1.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
