[Unit]
Description=Christoph Fischer ActivityPub backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/cfde/current
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node backend/server.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
